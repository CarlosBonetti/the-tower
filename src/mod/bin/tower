#!/bin/sh
# The tower command (src/cli.ts): on the PATH of every session the tower mod is loaded into, and the package's bin.
# It runs on TOWER_NODE, the node the tower runs on, where a session's runtime sets it (an opencode session's shell
# reads the user's profile, which can put an older node first), and else on the node the PATH finds.
self="$0"
while [ -L "$self" ]; do
  link="$(readlink "$self")"
  case "$link" in /*) self="$link" ;; *) self="$(dirname "$self")/$link" ;; esac
done
root="$(cd "$(dirname "$self")/../../.." && pwd)"
exec "${TOWER_NODE:-node}" "$root/node_modules/tsx/dist/cli.mjs" "$root/src/cli.ts" "$@"
